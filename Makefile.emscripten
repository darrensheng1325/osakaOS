# Emscripten Makefile for osakaOS
#
# Configure the DNS server the in-browser stack talks to via these vars:
#   DNS_SERVER_IP    - dotted-quad IPv4 address (default 127.0.0.1)
#   DNS_SERVER_PORT  - TCP port for DoH endpoint (default 8053)
# Example: make -f Makefile.emscripten DNS_SERVER_IP=10.0.2.2

EMCC = emcc

DNS_SERVER_IP   ?= 127.0.0.1
DNS_SERVER_PORT ?= 8053

DNS_DEFINES = -DDNS_SERVER_IP_STR='"$(DNS_SERVER_IP)"' -DDNS_SERVER_PORT=$(DNS_SERVER_PORT)

EMCCFLAGS = -Iinclude $(DNS_DEFINES) -s ALLOW_MEMORY_GROWTH=1 \
	-s EXPORTED_RUNTIME_METHODS='["ccall","cwrap","UTF8ToString","callMain"]' \
	-s EXPORTED_FUNCTIONS='["_main","_malloc","_free","_kernelMain","_printf","_putcharTUI","_shouldContinueCLILoop","_setCLILoopActive","_shouldContinueGUILoop","_setGUILoopActive","_web_yield","_handleMouseDown","_handleMouseUp","_handleMouseMove","_handleKeyDown","_handleKeyUp","_setKeyboardModifiers","_dnsResolveCallback","_executeCLICommand","_web_toggle_gui_mode","_web_leave_gui_mode","_httpFetchAsync","_httpFetchCallback","_httpFetchFail"]' \
	-s INITIAL_MEMORY=67108864 \
	-s STACK_SIZE=8388608 \
	-s USE_WEBGL2=0 \
	-s NO_EXIT_RUNTIME=1 \
	-s ASYNCIFY=1 \
	-s ASYNCIFY_STACK_SIZE=65536 \
	-s SINGLE_FILE=1 \
	-s WASM=1 \
	-g3 \
	--no-entry

# Source files (excluding assembly and hardware-specific files that need stubs)
SOURCES = src/kernel.cc \
	  src/gdt.cc \
	  src/memorymanagement.cc \
	  src/art.cc \
	  src/drivers/driver.cc \
	  src/multitasking.cc \
	  src/code/asm.cc \
	  src/gui/widget.cc \
	  src/gui/desktop.cc \
	  src/gui/window.cc \
	  src/gui/sim.cc \
	  src/gui/raycasting.cc \
	  src/gui/games/platformer.cc \
	  src/gui/games/shooter.cc \
	  src/net/network.cc \
	  src/net/etherframe.cc \
	  src/net/arp.cc \
	  src/net/ipv4.cc \
	  src/net/icmp.cc \
	  src/net/udp.cc \
	  src/net/tcp.cc \
	  src/filesys/ofs.cc \
	  src/cli.cc \
	  src/app.cc \
	  src/list.cc \
	  src/tree.cc \
	  src/string.cc \
	  src/functiontypes.cc \
	  src/app/paint.cc \
	  src/app/browser.cc \
	  src/app/file_edit.cc \
	  src/app/file_browse.cc \
	  src/app/iframe.cc \
	  src/app/settings.cc \
	  src/script.cc \
	  src/math.cc \
	  src/mode/piano.cc \
	  src/mode/snake.cc \
	  src/mode/file_edit.cc \
	  src/mode/space.cc \
	  src/drivers/vga_web.cc \
	  src/drivers/keyboard_web.cc \
	  src/drivers/mouse_web.cc \
	  src/hardwarecommunication/port.cc \
	  src/hardwarecommunication/interrupts_web.cc \
	  src/hardwarecommunication/pci.cc \
	  src/drivers/ata_stub.cc \
	  src/drivers/amd_am79c973_stub.cc \
	  src/drivers/ac97_stub.cc \
	  src/drivers/pit_web.cc \
	  src/drivers/cmos_stub.cc \
	  src/drivers/speaker_web.cc \
	  src/kernel_web.cc \
	  src/kernel_web_entry.cc \
	  src/kernel_web_loop.cc \
	  src/kernel_web_dns.cc \
	  src/kernel_web_http.cc

OBJECTS = $(SOURCES:.cc=.o)

all: osakaOS.js

osakaOS.js: $(OBJECTS)
	$(EMCC) $(EMCCFLAGS) -o osakaOS.js $(OBJECTS) -s EXPORT_NAME="'OsakaOS'"

%.o: %.cc
	$(EMCC) $(EMCCFLAGS) -c $< -o $@

clean:
	rm -f $(OBJECTS) osakaOS.js osakaOS.wasm

.PHONY: all clean
